# Port the HTTP/WebSocket server listens on
PORT=8080

# How often to poll the Chia node for new blocks (milliseconds)
POLL_INTERVAL_MS=3000

# Number of historical blocks to backfill on startup
BACKFILL_BLOCKS=150

# Google Vision API key for content filtering. If you don't want to use content filtering, leave this commented out.
# GOOGLE_VISION_API_KEY="xyz"

# path to the local NSFW model for content filtering. If you don't want to use content filtering, leave this commented out.
# LOCAL_NSFW_MODEL_PATH=./models/opennsfw2.onnx

# once you trust the local model's clean/nsfw agreement with Vision (see the logs), set this
# to actually skip Vision on a confident-clean local score instead of just logging the comparison.
# LOCAL_NSFW_ENFORCE_CLEAN=true

# Path to the SQLite database file used for content filtering. 
CONTENT_DB_PATH=./data/content-filter.sqlite

# Axiom API token and dataset for logging. If you don't want to use Axiom, leave these commented out.
# AXIOM_TOKEN=
# AXIOM_DATASET=

# Log level for pino (trace, debug, info, warn, error). Defaults to info.
# LOG_LEVEL=info
